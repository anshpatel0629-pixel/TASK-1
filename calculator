try:
    a = float(input("Enter first number "))

    b = float(input("Enter second number "))
     
    print("what kind of calculation do you want to do")

    print('''if you want addition use + 
        \nif you want subtraction use -
        \nif you want multiplication use *
        \nif you want division use /''')
    
    o = input("use sign: ")
    match o:
        case "+":
            print(f"the result is {a + b}")
        case "-":
            print(f"the result is {a - b}")
        case "/":
            print(f"the result is {a / b}")
        case "*":
            print(f"the result is {a * b}")

except Exception as e:
    print("enter a number")            
